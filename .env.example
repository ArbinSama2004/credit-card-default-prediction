# Copy to .env and adjust as needed. Not committed (see .gitignore).

# --- MLflow ---
# Local Docker MLflow UI/server (Stage 1). Colab logs locally instead —
# see docs/mlflow-workflow.md — so this URI matters only for local runs
# that talk to the Dockerized server directly.
MLFLOW_TRACKING_URI=http://localhost:5001

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# ARTIFACTS_DIR intentionally NOT set here. The default in app/config.py
# ("../ml/artifacts") already works for local `uv run` (Makefile always runs
# from backend/). The Docker image sets its own ARTIFACTS_DIR=/app/artifacts
# via the Dockerfile's ENV instruction — and since this file is passed to
# docker-compose as env_file, defining ARTIFACTS_DIR here would silently
# override that correct in-container path with the host-relative one and
# break the containerized backend. If you ever need to override it locally,
# set it as a real shell env var for that one run, not in this shared file.

# --- Frontend (Streamlit) ---
BACKEND_API_URL=http://localhost:8000
